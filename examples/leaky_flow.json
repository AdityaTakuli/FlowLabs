{
  "spec_version": "1.0",
  "flow_id": "flw_leaky",
  "name": "Leaky: scaling before the split",
  "description": "Must fail to compile with LEAKAGE_FIT_BEFORE_SPLIT on node 'scale'.",
  "dataset_bindings": { "primary": "churn" },
  "nodes": [
    { "id": "src", "type": "source.dataset", "params": { "dataset_ref": "primary", "target": "churned", "role_overrides": { "signup_date": "ignore" } } },
    { "id": "fill", "type": "clean.impute", "params": { "strategy": "constant", "fill_value": 0 } },
    { "id": "scale", "type": "prep.scale", "label": "Standardise everything", "params": { "method": "standard" } },
    { "id": "split", "type": "prep.split", "params": { "stratify_by": "churned" } },
    { "id": "encode", "type": "prep.encode", "params": { "method": "onehot" } },
    { "id": "fit", "type": "model.fit", "params": { "algorithm": "logistic_regression" } },
    { "id": "eval", "type": "model.evaluate", "params": {} }
  ],
  "edges": [
    { "id": "e1", "source": "src", "target": "fill" },
    { "id": "e2", "source": "fill", "target": "scale" },
    { "id": "e3", "source": "scale", "target": "split" },
    { "id": "e4", "source": "split", "target": "encode" },
    { "id": "e5", "source": "encode", "target": "fit", "target_port": "train" },
    { "id": "e6", "source": "fit", "source_port": "model", "target": "eval", "target_port": "model" },
    { "id": "e7", "source": "encode", "target": "eval", "target_port": "data" }
  ]
}
