    {
      "category": "source",
      "description": "Load a registered dataset.\n\nThe output schema is the dataset's inferred schema with any semantic and role\noverrides applied. Use ``target`` to declare what a model should predict and\n``role_overrides`` to exclude columns (``ignore``) from default feature sets.",
      "flags": {
        "cacheable": true,
        "is_correction": false,
        "is_hypothesis_test": false,
        "resamples_rows": false,
        "stochastic": false
      },
      "inputs": {},
      "outputs": {
        "out": {
          "description": "The loaded table",
          "types": [
            "table"
          ]
        }
      },
      "params_schema": {
        "$defs": {
          "Role": {
            "enum": [
              "feature",
              "target",
              "identifier",
              "ignore"
            ],
            "title": "Role",
            "type": "string"
          },
          "Semantic": {
            "enum": [
              "numeric_continuous",
              "numeric_discrete",
              "categorical_nominal",
              "categorical_ordinal",
              "binary",
              "datetime",
              "text_free",
              "identifier",
              "geo"
            ],
            "title": "Semantic",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "dataset_ref": {
            "description": "Logical dataset name declared in the flow's dataset_bindings.",
            "minLength": 1,
            "title": "Dataset",
            "type": "string",
            "x-widget": "dataset-select"
          },
          "role_overrides": {
            "additionalProperties": {
              "$ref": "#/$defs/Role"
            },
            "description": "Set a column's role to feature, target, identifier or ignore.",
            "title": "Role overrides",
            "type": "object"
          },
          "semantic_overrides": {
            "additionalProperties": {
              "$ref": "#/$defs/Semantic"
            },
            "description": "Correct inferred semantics, e.g. an integer that is really a category.",
            "title": "Semantic overrides",
            "type": "object"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Marks this column with role 'target' for downstream modelling.",
            "title": "Target column",
            "x-widget": "column-select"
          }
        },
        "required": [
          "dataset_ref"
        ],
        "title": "DatasetParams",
        "type": "object"
      },
      "title": "Dataset",
      "type": "source.dataset"
    },
    {
      "category": "viz",
      "description": "Plot the distribution of one column with a written finding.\n\nNumeric columns support histogram, box and ECDF charts; categorical columns render as a\nbar chart of the most frequent values. The narration states range, centre, skew and\nmissingness using only the computed values in ``narration_basis``.",
      "flags": {
        "cacheable": true,
        "is_correction": false,
        "is_hypothesis_test": false,
        "resamples_rows": false,
        "stochastic": false
      },
      "inputs": {
        "in": {
          "description": "",
          "required": true,
          "types": [
            "table",
            "table_split"
          ]
        }
      },
      "outputs": {
        "out": {
          "description": "",
          "types": [
            "chart"
          ]
        }
      },
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "bins": {
