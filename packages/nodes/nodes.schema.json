{
  "catalogue_version": "1",
  "nodes": [
    {
      "category": "clean",
      "description": "Remove columns by name or by rule (null fraction, cardinality).\n\nDrop identifiers and near-empty or constant columns before modelling. Rules are\nevaluated against the dataset profile, so the dropped set is known at compile time.",
      "flags": {
        "cacheable": true,
        "is_correction": false,
        "is_hypothesis_test": false,
        "resamples_rows": false,
        "stochastic": false
      },
      "inputs": {
        "in": {
          "description": "",
          "required": true,
          "types": [
            "table",
            "table_split"
          ]
        }
      },
      "outputs": {
        "out": {
          "description": "",
          "types": [
            "table",
            "table_split"
          ]
        }
      },
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "cardinality_eq": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "1 drops constant columns.",
            "title": "Drop if distinct count equals"
          },
          "columns": {
            "items": {
              "type": "string"
            },
            "title": "Columns to drop",
            "type": "array",
            "x-widget": "column-multiselect"
          },
          "null_frac_gt": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Rule-based drop.",
            "title": "Drop if null fraction above"
          }
        },
        "title": "DropColumnsParams",
        "type": "object"
      },
      "title": "Drop columns",
      "type": "clean.drop_columns"
    },
    {
      "category": "clean",
      "description": "Fill missing values.\n\nMean, median, mode, KNN and iterative imputation learn from data, so on a split they are\nfit on the train partition only and applied to every partition. Placing a learning\nimputer before ``prep.split`` is a leakage error.",
      "flags": {
        "cacheable": true,
        "is_correction": false,
        "is_hypothesis_test": false,
        "resamples_rows": false,
        "stochastic": false
      },
      "inputs": {
        "in": {
          "description": "",
          "required": true,
          "types": [
            "table",
            "table_split"
          ]
        }
      },
      "outputs": {
        "out": {
          "description": "",
          "types": [
            "table",
            "table_split"
          ]
        }
      },
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "columns": {
            "description": "Empty means every nullable feature column compatible with the strategy.",
            "items": {
              "type": "string"
            },
            "title": "Columns to impute",
            "type": "array",
            "x-widget": "column-multiselect"
          },
          "fill_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Constant value"
          },
          "knn_neighbors": {
            "default": 5,
            "maximum": 100,
            "minimum": 1,
            "title": "Knn Neighbors",
            "type": "integer"
          },
          "max_iter": {
            "default": 10,
            "maximum": 100,
            "minimum": 1,
            "title": "Max Iter",
            "type": "integer"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Seed"
          },
          "strategy": {
            "default": "median",
            "enum": [
              "mean",
              "median",
              "mode",
              "constant",
              "ffill",
              "knn",
              "iterative"
            ],
            "title": "Strategy",
            "type": "string",
            "x-descriptions": {
              "constant": "A fixed value you choose, e.g. 0 or 'unknown'.",
              "ffill": "Carry the previous row forward. For ordered/time data only.",
              "iterative": "Models each column from the others (MICE-style).",
              "knn": "Average of the k most similar rows. Uses the selected columns.",
              "mean": "Column average. Sensitive to outliers and skew.",
              "median": "Middle value. Robust default for skewed numeric data.",
              "mode": "Most frequent value. Works for categories."
            },
            "x-widget": "radio-cards"
          }
        },
        "title": "ImputeParams",
        "type": "object"
      },
      "title": "Impute missing",
      "type": "clean.impute"
    },
    {
      "category": "model",
      "description": "Score a fitted model on held-out data.\n\nClassification reports accuracy against the majority-class baseline, balanced accuracy,\nprecision, recall, F1, ROC AUC and a confusion matrix. Regression reports R-squared,\nMAE, RMSE and a predicted-vs-actual plot. Evaluating on the train partition is flagged.",
      "flags": {
        "cacheable": true,
        "is_correction": false,
        "is_hypothesis_test": false,
        "resamples_rows": false,
        "stochastic": false
      },
      "inputs": {
        "data": {
          "description": "Uses the chosen partition of a split",
          "required": true,
          "types": [
            "table",
            "table_split"
          ]
        },
        "model": {
          "description": "",
          "required": true,
          "types": [
            "model"
          ]
        }
      },
      "outputs": {
        "chart": {
          "description": "",
          "types": [
            "chart"
          ]
        },
        "metrics": {
          "description": "",
          "types": [
            "metrics"
          ]
        },
        "predictions": {
          "description": "",
          "types": [
            "table"
          ]
        }
      },
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "partition": {
            "default": "test",
            "description": "Which partition to score when the data input is a split.",
            "enum": [
              "test",
              "val",
              "train"
            ],
            "title": "Partition",
            "type": "string"
          },
          "positive_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Binary classification positive label.",
            "title": "Positive Class"
          }
        },
        "title": "EvaluateParams",
        "type": "object"
      },
      "title": "Evaluate model",
      "type": "model.evaluate"
    },
    {
      "category": "model",
      "description": "Fit a supervised model on the train partition.\n\nThe target defaults to the column with role ``target`` and the features to every\ncolumn with role ``feature``. Features must be numeric and free of missing values, which\nthe compiler checks before anything runs.",
      "flags": {
        "cacheable": true,
        "is_correction": false,
        "is_hypothesis_test": false,
        "resamples_rows": false,
        "stochastic": true
      },
      "inputs": {
        "train": {
          "description": "Uses the train partition of a split",
          "required": true,
          "types": [
            "table",
            "table_split"
          ]
        }
      },
      "outputs": {
        "model": {
          "description": "",
          "types": [
            "model"
          ]
        }
      },
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "default": "random_forest",
            "enum": [
              "logistic_regression",
              "linear_regression",
              "ridge",
              "lasso",
              "elastic_net",
              "decision_tree",
              "random_forest",
              "extra_trees",
              "gradient_boosting",
              "svm",
              "knn",
              "gaussian_nb"
            ],
            "title": "Algorithm",
            "type": "string",
            "x-descriptions": {
              "gradient_boosting": "Sequential trees; often the most accurate on tabular data.",
              "logistic_regression": "Linear, interpretable coefficients. Strong baseline.",
              "random_forest": "Robust ensemble of trees; little tuning needed."
            },
            "x-widget": "select"
          },
          "class_weight": {
            "default": "none",
            "enum": [
              "none",
              "balanced"
            ],
            "title": "Class Weight",
            "type": "string"
          },
          "features": {
            "description": "Defaults to every column with role 'feature'.",
            "items": {
              "type": "string"
            },
            "title": "Features",
            "type": "array",
            "x-widget": "column-multiselect"
          },
          "hyperparameters": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Hyperparameters",
            "type": "object"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Seed"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Defaults to the column with role 'target'.",
            "title": "Target",
            "x-widget": "column-select"
          },
          "task": {
            "default": "auto",
            "enum": [
              "auto",
              "classification",
              "regression"
            ],
            "title": "Task",
            "type": "string"
          }
        },
        "title": "FitParams",
        "type": "object"
      },
      "title": "Fit model",
      "type": "model.fit"
    },
    {
      "category": "prep",
      "description": "Turn categorical columns into numbers a model can use.\n\nEncoders learn the category vocabulary (and, for target encoding, per-category target\nmeans) from the train partition only. One-hot columns are derived from the profiled\ncategory list so the output schema is known before execution; categories unseen in\ntrain encode as all zeros.",
      "flags": {
        "cacheable": true,
        "is_correction": false,
        "is_hypothesis_test": false,
        "resamples_rows": false,
        "stochastic": false
      },
      "inputs": {
        "in": {
          "description": "",
          "required": true,
          "types": [
            "table",
            "table_split"
          ]
        }
      },
      "outputs": {
        "out": {
          "description": "",
          "types": [
            "table",
            "table_split"
          ]
        }
      },
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "columns": {
            "description": "Empty means every categorical feature column.",
            "items": {
              "type": "string"
            },
            "title": "Columns to encode",
            "type": "array",
            "x-filter": {
              "semantic": [
                "categorical_nominal",
                "categorical_ordinal",
                "binary"
              ]
            },
            "x-widget": "column-multiselect"
          },
          "method": {
            "default": "onehot",
            "enum": [
              "onehot",
              "ordinal",
              "frequency",
              "target",
              "binary"
            ],
            "title": "Method",
            "type": "string",
            "x-descriptions": {
              "binary": "Category code written in bits. Compact for many categories.",
              "frequency": "Replace each category by how often it occurs in train.",
              "onehot": "One 0/1 column per category. Best for few categories.",
              "ordinal": "Integer code per category. Use when categories have an order.",
              "target": "Replace each category by its smoothed mean target in train."
            },
            "x-widget": "radio-cards"
          },
          "ordinal_order": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "Explicit category order per column for ordinal.",
            "title": "Ordinal Order",
            "type": "object"
          },
          "smoothing": {
            "default": 10.0,
            "description": "Target encoding shrinkage toward the mean.",
            "minimum": 0,
            "title": "Smoothing",
            "type": "number"
          }
        },
        "title": "EncodeParams",
        "type": "object"
      },
      "title": "Encode categories",
      "type": "prep.encode"
    },
    {
      "category": "prep",
      "description": "Rescale numeric columns.\n\nScalers learn centre and spread from the train partition only and apply the same\ntransform to every partition. Distance-based and linear models benefit; tree models\ndo not need scaling.",
      "flags": {
        "cacheable": true,
        "is_correction": false,
        "is_hypothesis_test": false,
        "resamples_rows": false,
        "stochastic": false
      },
      "inputs": {
        "in": {
          "description": "",
          "required": true,
          "types": [
            "table",
            "table_split"
          ]
        }
      },
      "outputs": {
        "out": {
          "description": "",
          "types": [
            "table",
            "table_split"
          ]
        }
      },
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "columns": {
            "description": "Empty means every non-binary numeric feature column.",
            "items": {
              "type": "string"
            },
            "title": "Columns to scale",
            "type": "array",
            "x-filter": {
              "semantic": [
                "numeric_continuous",
                "numeric_discrete"
              ]
            },
            "x-widget": "column-multiselect"
          },
          "method": {
            "default": "standard",
            "enum": [
              "standard",
              "minmax",
              "robust",
              "quantile"
            ],
            "title": "Method",
            "type": "string",
            "x-descriptions": {
              "minmax": "Rescale to the 0-1 range. Sensitive to outliers.",
              "quantile": "Maps values to their train quantile. Removes skew entirely.",
              "robust": "Uses median and IQR — better when outliers are present.",
              "standard": "Mean 0, SD 1. Default choice for most models."
            },
            "x-widget": "radio-cards"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Seed"
          }
        },
        "title": "ScaleParams",
        "type": "object"
      },
      "title": "Scale numeric",
      "type": "prep.scale"
    },
    {
      "category": "prep",
      "description": "Partition rows into train/test (and optionally validation).\n\nEverything that learns from data must sit after this node. Stratify on a classification\ntarget to keep class balance, group by an entity id when rows are not independent, and\nuse a time-based split whenever rows are ordered in time.",
      "flags": {
        "cacheable": true,
        "is_correction": false,
        "is_hypothesis_test": false,
        "resamples_rows": false,
        "stochastic": true
      },
      "inputs": {
        "in": {
          "description": "",
          "required": true,
          "types": [
            "table"
          ]
        }
      },
      "outputs": {
        "out": {
          "description": "",
          "types": [
            "table_split"
          ]
        }
      },
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "group_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Keep all rows of a group (e.g. a customer) in the same partition.",
            "title": "Group by",
            "x-widget": "column-select"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Seed"
          },
          "stratify_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Keep class proportions equal across partitions.",
            "title": "Stratify by",
            "x-widget": "column-select"
          },
          "test_size": {
            "default": 0.2,
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
            "title": "Test fraction",
            "type": "number"
          },
          "time_based": {
            "default": false,
            "description": "Train on earlier rows, test on later rows.",
            "title": "Time Based",
            "type": "boolean"
          },
          "time_column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Time Column",
            "x-widget": "column-select"
          },
          "val_size": {
            "default": 0.0,
            "exclusiveMaximum": 1,
            "minimum": 0,
            "title": "Validation fraction",
            "type": "number"
          }
        },
        "title": "SplitParams",
        "type": "object"
      },
      "title": "Train/test split",
      "type": "prep.split"
    },
    {
      "category": "profile",
      "description": "Null counts per column, rows with any null, and the missingness correlation matrix.\n\nCorrelated missingness (two columns that tend to be null together) suggests values are\nnot missing at random, which matters when choosing an imputation strategy.",
      "flags": {
        "cacheable": true,
        "is_correction": false,
        "is_hypothesis_test": false,
        "resamples_rows": false,
        "stochastic": false
      },
