    {
      "category": "sink",
      "description": "Write a table (or each partition of a split) to storage.\n\nSinks always run, even when their inputs are cached, so the file is guaranteed to exist\nafter every run.",
      "flags": {
        "cacheable": false,
        "is_correction": false,
        "is_hypothesis_test": false,
        "resamples_rows": false,
        "stochastic": false
      },
      "inputs": {
        "in": {
          "description": "",
          "required": true,
          "types": [
            "table",
            "table_split"
          ]
        }
      },
      "outputs": {},
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "destination": {
            "const": "local",
            "default": "local",
            "description": "Phase 0 supports local only.",
            "title": "Destination",
            "type": "string"
          },
          "format": {
            "default": "parquet",
            "enum": [
              "parquet",
              "csv"
            ],
            "title": "Format",
