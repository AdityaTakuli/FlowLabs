# Copy to .env (gitignored) and fill in.
GROQ_API_KEY=
# Optional: any Groq chat model id. Smaller models spend fewer tokens.
# FLOWLAB_LLM_MODEL=openai/gpt-oss-20b

# GitHub OAuth app (used from Phase 1: API auth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (used from Phase 1: API auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# While the consent screen is in Testing mode, only listed test users can sign in
GOOGLE_TEST_USER=
